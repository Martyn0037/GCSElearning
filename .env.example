# .env.example — copy to .env, fill in, then run `chmod 600 .env`. Never commit .env.
# Generate each secret with:  openssl rand -base64 48

# Public hostname. Use "localhost" locally (Caddy issues a local certificate).
DOMAIN=localhost

ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_USER=gcse
POSTGRES_PASSWORD=
POSTGRES_DB=gcse

# At least 32 characters each; the API refuses to start otherwise.
JWT_SECRET=
AUDIT_IP_SALT=

