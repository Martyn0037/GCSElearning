# .env.example — copy to .env, fill in, then run `chmod 600 .env`. Never commit .env.
# Generate each secret with:  openssl rand -base64 48

# Public hostname. Use "localhost" locally (Caddy issues a local certificate).
DOMAIN=localhost

ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_USER=gcse
POSTGRES_PASSWORD=
POSTGRES_DB=gcse

# At least 32 characters each; the API refuses to start otherwise.
JWT_SECRET=
AUDIT_IP_SALT=

# Claude API key (https://console.anthropic.com). Optional: without it the app
# serves only questions already in the bank.
ANTHROPIC_API_KEY=
# Spending caps in pounds; the app stops calling Claude when either is reached.
AI_MONTHLY_BUDGET_GBP=25
AI_DAILY_BUDGET_GBP=2.50
# true = new questions wait for admin approval before he sees them.
QUESTION_STRICT_MODE=false

# Backups (infra/backup): a nightly database dump, kept locally for
# BACKUP_KEEP_DAYS days. Set a bucket and an IAM key that can only put objects
# there to also keep off-site copies (DEPLOY.md). Leave blank for local only.
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=7
BACKUP_S3_BUCKET=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=eu-west-2
