                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Sign out: revoke this session's refresh tokens and clear cookies. Idempotent.",
        "operationId": "logout",
        "parameters": [
          {
            "in": "cookie",
            "name": "gc_refresh",
            "required": false,
            "schema": {
              "anyOf": [
