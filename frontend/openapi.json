{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "The body of an error.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "traceId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Traceid"
          }
        },
        "required": [
          "code",
          "message",
          "traceId"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "The standard error envelope returned by every endpoint.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "Credentials for signing in.",
        "properties": {
          "identifier": {
            "description": "Username or email",
            "maxLength": 254,
            "minLength": 1,
            "title": "Identifier",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ResetPasswordRequest": {
        "additionalProperties": false,
        "description": "An admin setting a student's new password.",
        "properties": {
          "newPassword": {
            "maxLength": 128,
            "minLength": 10,
            "title": "Newpassword",
            "type": "string"
          }
        },
        "required": [
          "newPassword"
        ],
        "title": "ResetPasswordRequest",
        "type": "object"
      },
      "Role": {
        "description": "What a user is allowed to do.",
        "enum": [
          "student",
          "guardian",
          "admin"
        ],
        "title": "Role",
        "type": "string"
      },
      "SessionOut": {
        "additionalProperties": false,
        "description": "Returned after login or refresh. Tokens themselves travel only in cookies.",
        "properties": {
          "accessTokenExpiresAt": {
            "format": "date-time",
            "title": "Accesstokenexpiresat",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "accessTokenExpiresAt"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "UserOut": {
        "additionalProperties": false,
        "description": "A user as visible to themselves, their guardian, or an admin.",
        "properties": {
          "displayName": {
            "title": "Displayname",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          }
        },
        "required": [
          "id",
          "role",
          "displayName",
          "username",
          "email"
        ],
        "title": "UserOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "GCSE Coach API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/students/{student_id}/password": {
      "post": {
        "description": "Set a student's password and sign them out of every device.",
        "operationId": "resetStudentPassword",
        "parameters": [
          {
            "in": "path",
            "name": "student_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Student Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Reset Student Password",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Sign in with a username (student) or email (guardian/admin).\n\nRate-limited per IP and per account identifier, on top of the per-account\nlockout after repeated failures.",
        "operationId": "login",
        "requestBody": {
