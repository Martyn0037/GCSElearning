    "/api/v1/users/{user_id}": {
      "get": {
        "description": "Return a user the caller is allowed to see.\n\nAdmins can see anyone; guardians their linked students; others only\nthemselves. Anything else is reported as not found.",
        "operationId": "getUser",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          }
        ],
        "responses": {
